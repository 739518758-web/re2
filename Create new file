#import <UIKit/UIKit.h>

// 弹出卡密输入弹窗
@interface CardVerifyManager : NSObject
+ (void)showVerifyAlert;
@end

@implementation CardVerifyManager

+ (void)showVerifyAlert {
    dispatch_async(dispatch_get_main_queue(), ^{
        UIWindow *keyWindow = [UIApplication sharedApplication].keyWindow;
        UIViewController *rootVC = keyWindow.rootViewController;
        
        UIAlertController *alert = [UIAlertController alertControllerWithTitle:@"PUBGM VIP 验证" 
                                                                   message:@"请输入您的卡密以激活辅助" 
                                                            preferredStyle:UIAlertControllerStyleAlert];
        
        [alert addTextFieldWithConfigurationHandler:^(UITextField *textField) {
            textField.placeholder = @"请输入卡密";
            textField.clearButtonMode = UITextFieldViewModeWhileEditing;
        }];
        
        UIAlertAction *submitAction = [UIAlertAction actionWithTitle:@"确定" style:UIAlertActionStyleDefault handler:^(UIAlertAction * _Nonnull action) {
            UITextField *textField = alert.textFields.firstObject;
            NSString *cardKey = textField.text;
            
            if (cardKey.length == 0) {
                [CardVerifyManager showAlertWithTitle:@"错误" message:@"卡密不能为空"];
                [CardVerifyManager showVerifyAlert];
                return;
            }
            [CardVerifyManager verifyCard:cardKey];
        }];
        
        [alert addAction:submitAction];
        if (rootVC) {
            [rootVC presentViewController:alert animated:YES completion:nil];
        }
    });
}

+ (void)verifyCard:(NSString *)cardKey {
    NSString *deviceId = [[[UIDevice currentDevice] identifierForVendor] UUIDString];
    // ⚠️【注意】请将此处修改为你实际的后端服务器 IP 和端口
    NSString *urlString = @"http://你的服务器IP:3000/api/verify-key";
    NSURL *url = [NSURL URLWithString:urlString];
    
    NSMutableURLRequest *request = [NSMutableURLRequest requestWithURL:url];
    [request setHTTPMethod:@"POST"];
    [request setValue:@"application/json" forHTTPHeaderField:@"Content-Type"];
    
    NSDictionary *body = @{@"card_key": cardKey, @"device_id": deviceId ? deviceId : @"unknown"};
    [request setHTTPBody:[NSJSONSerialization dataWithJSONObject:body options:0 error:nil]];
    
    NSURLSessionDataTask *task = [[NSURLSession sharedSession] dataTaskWithRequest:request completionHandler:^(NSData *data, NSURLResponse *response, NSError *error) {
        if (error || !data) {
            [CardVerifyManager showAlertWithTitle:@"网络错误" message:@"无法连接到服务器"];
            [CardVerifyManager showVerifyAlert];
            return;
        }
        
        NSDictionary *resDict = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
        NSInteger code = [resDict[@"code"] integerValue];
        NSString *msg = resDict[@"msg"] ?: @"未知错误";
        
        if (code == 200) {
            [CardVerifyManager showAlertWithTitle:@"验证成功" message:msg];
        } else {
            [CardVerifyManager showAlertWithTitle:@"验证失败" message:msg];
            [CardVerifyManager showVerifyAlert];
        }
    }];
    [task resume];
}

+ (void)showAlertWithTitle:(NSString *)title message:(NSString *)message {
    dispatch_async(dispatch_get_main_queue(), ^{
        UIAlertController *alert = [UIAlertController alertControllerWithTitle:title message:message preferredStyle:UIAlertControllerStyleAlert];
        [alert addAction:[UIAlertAction actionWithTitle:@"确定" style:UIAlertActionStyleDefault handler:nil]];
        [UIWindow.sharedApplication.keyWindow.rootViewController presentViewController:alert animated:YES completion:nil];
    });
}

@end

%ctor {
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        [CardVerifyManager showVerifyAlert];
    });
}
